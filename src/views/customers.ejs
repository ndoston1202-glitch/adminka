<%- include('partials/header', { title: 'Mijozlar' }) %>
<div class="card">
  <div class="card-head">
    <h2>Mijozlar</h2>
    <form class="search" method="get"><input name="q" value="<%= q %>" placeholder="Ism, kafe yoki telefon..."><button class="btn">Qidirish</button></form>
    <a class="btn primary" href="/customers/new">+ Yangi mijoz</a>
  </div>
  <% if (!customers.length) { %><p class="muted">Mijoz topilmadi.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Kafe</th><th>Ism</th><th>Telefon</th><th>Kalitlar</th><th>Muddat</th><th>Qo'shilgan</th></tr></thead>
    <tbody>
    <% customers.forEach(c => { %>
      <tr>
        <td><a href="/customers/<%= c.id %>"><%= c.cafe_name || '—' %></a></td>
        <td><a href="/customers/<%= c.id %>"><%= c.name %></a></td>
        <td><%= c.phone || '—' %></td>
        <td><%= c.license_count %></td>
        <td><%= h.date(c.max_expires) %></td>
        <td><%= h.date(c.created_at) %></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
</div>
<%- include('partials/footer') %>
