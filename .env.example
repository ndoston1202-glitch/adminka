# Sanalar shu vaqt zonasida ko'rsatiladi
APP_TIMEZONE=Asia/Tashkent

PORT=3000
# Lokal ishlatish uchun. Netlify'da kerak emas (Netlify Database avtomatik ulanadi)
DATABASE_URL=postgres://cafepos:cafepos@localhost:5432/adminka

# Sessiya uchun uzun tasodifiy satr (masalan: openssl rand -hex 32)
SESSION_SECRET=change-me

# Ed25519 kalitlari (npm run gen-keys buyrug'i bilan yaratiladi).
# Shaxsiy kalit faqat serverda turadi; ochiq kalit CafePOS ichiga joylanadi.
LICENSE_PRIVATE_KEY_PATH=./keys/license_private.pem
LICENSE_PUBLIC_KEY_PATH=./keys/license_public.pem

# Internet bo'lmaganda CafePOS necha kun ishlay oladi
OFFLINE_GRACE_DAYS=7

# Productionda HTTPS orqasida ishlasa true qiling
COOKIE_SECURE=false

# Bazada admin bo'lmasa, birinchi ishga tushishda shu login/parol bilan yaratiladi
ADMIN_USERNAME=
ADMIN_PASSWORD=
